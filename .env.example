# Public subscription mode (recommended): users enter their 3x-ui subscription ID.
XUI_LOOKUP_MODE=subscription
XUI_SUBSCRIPTION_URL_TEMPLATE=https://subscription.example.com/your-sub-path/{id}

# Authenticated UUID mode: users enter their actual VLESS/VMess client UUID.
# XUI_LOOKUP_MODE=admin_uuid
# XUI_PANEL_URL=https://panel.example.com/your-panel-base-path
# XUI_API_TOKEN=replace-with-a-read-only-or-monitor-token

# Optional runtime settings.
APP_HOST=127.0.0.1
APP_PORT=8080
XUI_REQUEST_TIMEOUT=8
XUI_CACHE_SECONDS=15
XUI_RATE_LIMIT_PER_MINUTE=30
# XUI_DEMO_MODE=1

